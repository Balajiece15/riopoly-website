# =============================================================================
# RioPoly — Environment Variables (PLACEHOLDERS ONLY)
# Copy to .env (dev) / .env.production (server) and fill real values there.
# NEVER commit .env*. Real secrets go on disk / Vercel env store only.
# =============================================================================

# ----- App -----
NEXT_PUBLIC_APP_URL="https://riopoly.gotoanalyze.com"

# ----- Razorpay (SERVER) -----
# Dev: use rzp_test_...  |  Prod: rzp_live_... (only in .env.production on server)
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="REPLACE_razorpay_key_secret"
# The signing secret you entered when creating the webhook in the dashboard.
RAZORPAY_WEBHOOK_SECRET="REPLACE_razorpay_webhook_secret"

# ----- Razorpay (CLIENT) — publishable Key ID ONLY, never the secret -----
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXXXX"

# ----- Supabase -----
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="REPLACE_supabase_anon_key"
# Service role bypasses RLS — SERVER ONLY, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_supabase_service_role_key"

# ----- Database (Prisma -> Supabase Postgres) -----
# Pooled (PgBouncer, 6543) for app/serverless runtime.
DATABASE_URL="postgresql://postgres.YOUR_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (5432) — required by Prisma Migrate. (Recommended addition to your list.)
DIRECT_URL="postgresql://postgres.YOUR_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ----- Auth (NextAuth) -----
NEXTAUTH_URL="https://riopoly.gotoanalyze.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_nextauth_secret"

# ----- Email (Resend — receipts + invoice PDFs) -----
RESEND_API_KEY="re_XXXXXXXXXXXXXXXX"
EMAIL_FROM="RioPoly Billing <billing@gotoanalyze.com>"
